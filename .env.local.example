NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
RESEND_API_KEY=your-resend-api-key

# EasyPost API key for shipment tracking. Get free key at easypost.com.
# Leave empty to disable tracking (shipments still logged, just no status updates)
EASYPOST_API_KEY=

# 3:30pm Pacific Today digest (cron-triggered).
# CRON_SECRET — Bearer token Vercel Cron sends to /api/cron/today-digest.
#   Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#   Set the same value in Vercel project env vars (production scope).
# DIGEST_FROM_EMAIL — must be a verified sender on the kleinmfgllc.com Resend domain.
# DIGEST_TO_EMAIL — recipient address for the digest.
CRON_SECRET=
DIGEST_FROM_EMAIL=digest@kleinmfgllc.com
DIGEST_TO_EMAIL=sales@kleinmfgllc.com

# Cowork-facing API token. Required by:
#   POST /api/inbox-sync
#   GET  /api/leads
#   POST /api/leads/:id/classify
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Set the same value in Vercel project env (production scope) and in
# the Cowork scheduled-task SKILLs that POST inbox proposals.
COWORK_API_TOKEN=

# Phase 2 conversation-state classifier — Anthropic API key.
# Required by /api/leads/:id/classify (the Haiku call) and any code
# path that triggers classification inline (e.g. the approve route
# after a new_activity row is inserted). Set in Vercel project env
# for production. Get key at console.anthropic.com.
ANTHROPIC_API_KEY=
